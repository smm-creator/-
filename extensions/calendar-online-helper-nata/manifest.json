{
  "manifest_version": 3,
  "name": "Calendar.online Helper — Ната",
  "description": "Швидке додавання задач для Наталії у Calendar.online на весь день",
  "version": "1.0.0",
  "permissions": ["storage"],
  "host_permissions": ["https://api.calendar.online/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Додати задачі — Ната",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
